# The mock Machines a development build starts with: a scenario from src/shared/machines/seed.ts,
# or off. With this and EXPO_PUBLIC_MOCK_PAIRING off, the build pairs real Machines.
EXPO_PUBLIC_MOCK_DATA=machines
# on: the mock Machines refuse the first attempt of each command and every other one after.
EXPO_PUBLIC_MOCK_FAILURES=off
# How Add Machine goes: approve, decline, unreachable, unusable, full, already-paired, or off.
# When it is not off, a tap on the camera preview stands in for scanning a QR code.
EXPO_PUBLIC_MOCK_PAIRING=approve
# Override any of these in .env.local.
