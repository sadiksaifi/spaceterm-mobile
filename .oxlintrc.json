{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true
  },
  "ignorePatterns": [".agents/", ".claude/skills/"],
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)ios(/|$)",
                "message": "Only iOS code imports iOS code."
              },
              {
                "regex": "^@expo/ui/swift-ui",
                "message": "SwiftUI views exist only on iOS."
              },
              {
                "regex": "(^|/)android(/|$)",
                "message": "Only Android code imports Android code."
              },
              {
                "regex": "^@expo/ui/jetpack-compose",
                "message": "Jetpack Compose views exist only on Android."
              },
              {
                "regex": "^@expo/material-symbols/",
                "message": "Material Symbols are Android vector drawables."
              },
              {
                "regex": "^@/modules/search-bar",
                "message": "The search bar module is built for Android only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.android.ts", "src/**/*.android.tsx", "src/**/android/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)ios(/|$)",
                "message": "Only iOS code imports iOS code."
              },
              {
                "regex": "^@expo/ui/swift-ui",
                "message": "SwiftUI views exist only on iOS."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.ios.ts", "src/**/*.ios.tsx", "src/**/ios/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)android(/|$)",
                "message": "Only Android code imports Android code."
              },
              {
                "regex": "^@expo/ui/jetpack-compose",
                "message": "Jetpack Compose views exist only on Android."
              },
              {
                "regex": "^@expo/material-symbols/",
                "message": "Material Symbols are Android vector drawables."
              },
              {
                "regex": "^@/modules/search-bar",
                "message": "The search bar module is built for Android only."
              }
            ]
          }
        ]
      }
    }
  ]
}
